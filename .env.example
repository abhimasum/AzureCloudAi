# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=azure-ai-agents-rg
AZURE_LOCATION=eastus

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=geography_index
AZURE_SQL_USER=your-admin-user
AZURE_SQL_PASSWORD=your-password

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=geography-docs

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_KEY=your-storage-key
AZURE_STORAGE_CONTAINER=geography-docs

# Azure Container Apps
ORCHESTRATOR_URL=https://orchestrator-agent.azurecontainerapps.io
RETRIEVER_AGENT_URL=https://retriever-agent.azurecontainerapps.io

# Model Configuration  
ORCHESTRATOR_MODEL=gpt-4o
RETRIEVER_MODEL=gpt-4o
SQL_AGENT_MODEL=gpt-4o
